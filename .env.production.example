# =============================================================================
# IntelliHire — production environment template
# =============================================================================
# Copy to .env.production (git-ignored) and fill in EVERY value before running:
#
#   cp .env.production.example .env.production
#   # generate real secrets:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#
# The placeholder secrets below were generated once for illustration ONLY.
# Regenerate every one of them — never deploy a value that appears in git.
# =============================================================================

# --- Runtime mode -----------------------------------------------------------
# Must be exactly "production": config.py then enforces https-only APP_URL and
# an explicit CORS allowlist (refuses "*" and non-https origins).
NODE_ENV=production

# --- Public URLs ------------------------------------------------------------
# Final HTTPS origin users browse to (no trailing slash). TLS is terminated by
# your host reverse proxy which forwards to the app on 127.0.0.1:5000.
APP_URL=https://app.example.com
# Comma-separated, explicit HTTPS browser origins only — no wildcards, no http.
# Include every origin the SPA is served from (APP_URL must be listed again).
CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Core crypto secrets ----------------------------------------------------
# JWT signing + signed-asset-download HMAC key. Minimum 32 characters; use 48+
# random bytes. Rotating this value invalidates ALL active sessions AND every
# outstanding signed download URL (by design — see DEPLOYMENT_GUIDE.md).
JWT_SECRET=2ptt48RqsipQvtpNCrE7feR7-gun13vacpP8hO__T24amqx5JPMzPo-JLDcnYEgH
# Shared secret for POST /internal/notify (server-to-server realtime pushes).
# The endpoint refuses all traffic while this is unset.
INTERNAL_API_SECRET=Qfgvx_-Ks_5YD2xyszTYaVpAZnbycPG5vosvuksxgz4
# Bearer token Prometheus must send to scrape /metrics. In production the
# metrics endpoint 503s unless this is set (app/middleware/metrics_guard.py).
METRICS_TOKEN=Pe-6pnBgNeKdsV7QMZgDmTbSE2YsX0F-iYCoExC6eFs

# --- PostgreSQL -------------------------------------------------------------
# Password only — docker-compose.prod.yml runs Postgres with user "intellihire"
# and db "intellihire" and assembles DATABASE_URL automatically:
#   postgresql://intellihire:<POSTGRES_PASSWORD>@postgres:5432/intellihire
# Do NOT set DATABASE_URL here; it would be overridden by the compose file.
POSTGRES_PASSWORD=pAH3AIAj906LNTj7mCErhcKOc-SNbXMX

# --- Redis ------------------------------------------------------------------
# Same story: compose runs Redis with --requirepass and assembles
#   redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_PASSWORD=FNjAYDlYeya67CZfvPjrP0znanQnE8gx

# --- S3 / MinIO object storage ---------------------------------------------
# Managed by compose: the app always reaches MinIO over the internal network.
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
S3_BUCKET_NAME=intellihire-uploads
# MinIO root account (server admin). Use a strong generated value, NOT
# minioadmin/minioadminpass.
MINIO_ROOT_USER=UfD75DLn98STX_sDhOtZsQ9oxYdmueMT
MINIO_ROOT_PASSWORD=1I_5gqGv9QeGFSJFPn1aE5b7ZLxB3eMm
# Dedicated app account (read-write on S3_BUCKET_NAME only). minio-init creates
# it at startup; the app never uses the root credentials.
MINIO_APP_ACCESS_KEY=tnEj15hdGMZtuv92Y9nucWZkw4u_b6ZT
MINIO_APP_SECRET_KEY=WrYq3nF8sK2pLmT9vCxZ5aQ7dE0hJ6uB4gN8cR1x
# Optional: override the pinned MinIO image (community images left Docker Hub
# in Oct 2025; compose defaults to quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z).
# MINIO_IMAGE=cgr.dev/chainguard/minio

# --- Judge0 (private code execution) ---------------------------------------
# Production refuses the public ce.judge0.com endpoint. Point this at the
# self-hosted judge0 from docker-compose.prod.yml's "judge0" profile, or at
# your external private judge0 instance.
JUDGE0_API_URL=http://judge0-server:2358
# Judge0 auth token sent as X-Auth-Token. Leave empty for a bare self-hosted
# judge0 without user tokens; set it if you enable authentication.
JUDGE0_API_KEY=
# Credentials for judge0's own postgres/redis (used only when the judge0
# compose profile is enabled).
JUDGE0_DB_PASSWORD=BHm-7TqK9QQkpD_L0hjiMzUFotR7qJ9e
JUDGE0_REDIS_PASSWORD=n7AAnCG_1FnUpweTEJ-qoYWlBcN7Xq7h

# --- Email (SMTP) -----------------------------------------------------------
# Required for notification emails; health reports "degraded" without it.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=IntelliHire <noreply@example.com>

# --- AI (Groq) --------------------------------------------------------------
# Optional: voice interviews, marksheet scanning, proctoring. Exams run on the
# local pipeline without it; health reports "degraded" when unset.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Observability ----------------------------------------------------------
# Sentry error tracking. Leave empty to disable.
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Managed by docker-compose.prod.yml (do not set here) -------------------
# DATABASE_URL       — assembled from POSTGRES_PASSWORD
# REDIS_URL          — assembled from REDIS_PASSWORD
# S3_ENDPOINT        — http://minio:9000
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY — MINIO_APP_* above
# FILE_STORAGE_DIR   — /app/uploads (named volume; root fs is read-only)
# PORT               — 5000 (published only on 127.0.0.1)
