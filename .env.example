VITE_API_URL=http://localhost:3000/api

# PostgreSQL connection. You can use DATABASE_URL or the PG* variables below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intellihire
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=intellihire
# PGUSER=postgres
# PGPASSWORD=postgres
# PGSSL=false

# Local file storage for interview audio uploads.
FILE_STORAGE_DIR=uploads
# PUBLIC_STORAGE_URL=http://localhost:5000

# Object storage bucket for resumes, interview audio, and proctoring artifacts.
S3_BUCKET_NAME=intellihire-uploads
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key

# MUST be at least 32 characters long. The app will refuse to start without it.
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars

PORT=5000

# Set to 'production' for deployed environments. Controls CORS, logging, and error detail.
NODE_ENV=development

# Optional: Groq API key for AI voice interviews, marksheet scanning, proctoring, and test evaluation.
# Exams use the local IntelliHire Pipeline (zero API calls) so this is NOT needed for exam generation.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Ollama for zero-cost local LLM fallback (not required for exams).
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# Judge0 Code Execution
# Defaults to the public Judge0 CE endpoint during local development only.
# Production code execution requires a private Judge0 instance.
# JUDGE0_API_URL=https://your-private-judge0-instance.com
# JUDGE0_API_KEY=

# Email (SMTP) - optional. If not configured, email notifications are skipped.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=IntelliHire <noreply@intellihire.com>

# Logging. Optional. Defaults to 'info'. Use 'debug' for verbose logging in development.
# LOG_LEVEL=info

# Error Tracking (Sentry). If not configured, Sentry is disabled.
# SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id
