{
  "name": "intellihire",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:py\" \"npm --prefix client run dev\"",
    "client": "npm --prefix client run dev",
    "server": "npm run server:py",
    "server:py": "node scripts/run-uvicorn.js server_py.app.main:app --port 5000 --host 0.0.0.0 --reload --reload-dir server_py",
    "build": "npm --prefix client run build",
    "check": "npm --prefix client run check",
    "lint": "npm --prefix client run lint",
    "preview": "npm --prefix client run preview",
    "start": "node scripts/run-uvicorn.js server_py.app.main:app --port 5000 --host 0.0.0.0",
    "test:e2e": "npx playwright test",
    "gen:api-types": "node scripts/export-openapi.mjs && openapi-typescript reports/openapi.json -o client/src/lib/api-types.gen.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.61.1"
  }
}
