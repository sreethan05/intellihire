{
  "name": "intellihire",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:py\" \"npm --prefix client run dev\"",
    "client": "npm --prefix client run dev",
    "server": "npm run server:py",
    "server:py": "server_py\\.venv\\Scripts\\uvicorn server_py.app.main:app --port 5000 --host 0.0.0.0 --reload",
    "build": "npm --prefix client run build",
    "check": "npm --prefix client run check",
    "lint": "npm --prefix client run lint",
    "preview": "npm --prefix client run preview",
    "start": "server_py\\.venv\\Scripts\\uvicorn server_py.app.main:app --port 5000 --host 0.0.0.0",
    "test:e2e": "npx playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.1.2",
    "playwright": "^1.61.1"
  }
}
