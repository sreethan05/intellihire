{
  "name": "intellihire-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec tsx src/index.ts",
    "start": "tsx src/index.ts",
    "test": "tsx --test \"tests/**/*.test.ts\" \"src/lib/**/*.test.ts\"",
    "test:coverage": "c8 --reporter=html --reporter=text --lines=60 --functions=60 --branches=60 --statements=60 tsx --test \"tests/**/*.test.ts\" \"src/lib/**/*.test.ts\"",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "migrate": "tsx src/scripts/applyMigrations.ts",
    "seed:e2e": "tsx src/seed_e2e_users.ts",
    "seed-offline-60": "tsx src/scripts/generateOffline60.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@sentry/node": "^9.15.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "c8": "^10.1.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
